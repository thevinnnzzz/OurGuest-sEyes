# --- Frontend (Vite, exposed to browser) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
VITE_APP_URL=http://localhost:5173

# --- Server (never exposed to browser) ---
SERVER_PORT=4000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Protect the manual purge endpoint
PURGE_API_TOKEN=choose-a-random-secret

# Owner account is created in Supabase Auth dashboard; no secret here.
